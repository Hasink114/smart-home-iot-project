# Firebase web app configuration (public client identifiers — NOT secrets).
# Copy this file to `.env` and fill in the values from:
# Firebase Console → Project Settings → General → Your apps → SDK setup and configuration
#
# Required for any Firebase feature to work. Without these the app runs in
# "awaiting configuration" mode and shows a status banner instead of live data.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
# Existing Realtime Database project:
VITE_FIREBASE_DATABASE_URL=https://esp32-relay-control-e1413-default-rtdb.firebaseio.com
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
